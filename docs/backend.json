{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Information about users, including roles for authorization.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastActive": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    },
    "Document": {
      "title": "Archive Document",
      "description": "PDFs and other documents uploaded for the public archive.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "fileUrl": { "type": "string" },
        "uploadedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "fileUrl", "uploadedAt"]
    },
    "GalleryImage": {
      "title": "Gallery Image",
      "description": "Images displayed in the public gallery.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["imageUrl", "createdAt"]
    },
    "Registration": {
      "title": "CHIASMA 1.0 Registration",
      "description": "Registration details for the CHIASMA 1.0 event.",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "gender": { "type": "string", "enum": ["Male", "Female"] },
        "level": { "type": "string" },
        "department": { "type": "string" },
        "college": { "type": "string" },
        "receiptUrl": { "type": "string" },
        "submittedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fullName", "email", "gender", "level", "department", "college", "receiptUrl", "submittedAt"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user roles and profiles."
    },
    "/documents/{docId}": {
      "schema": "Document",
      "description": "Stores metadata for archived files."
    },
    "/gallery/{imageId}": {
      "schema": "GalleryImage",
      "description": "Stores metadata for gallery images."
    },
    "/registrations/{regId}": {
      "schema": "Registration",
      "description": "Stores event registrations."
    }
  }
}